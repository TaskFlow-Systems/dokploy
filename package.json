{
	"name": "dokploy",
	"private": true,
	"workspaces": [
		"apps/api",
		"apps/dokploy",
		"apps/schedules",
		"packages/server"
	],
	"scripts": {
		"dokploy:setup": "bun run --filter './apps/dokploy' setup",
		"dokploy:dev": "bun run --filter './apps/dokploy' dev",
		"dokploy:build": "bun run --filter './apps/dokploy' build",
		"dokploy:start": "bun run --filter './apps/dokploy' start",
		"test": "bun run --filter './apps/dokploy' test",
		"server:script": "bun run --filter './packages/server' switch:dev",
		"server:dev": "bun run --filter './packages/server' dev",
		"server:build": "bun run --filter './packages/server' build",
		"docker:build:canary": "./apps/dokploy/docker/build.sh canary",
		"typecheck": "bun run --filter '*' typecheck",
		"build": "bun run --filter '*' build",
		"format-and-lint": "biome check .",
		"check": "biome check --write --no-errors-on-unmatched --files-ignore-unknown=true",
		"format-and-lint:fix": "biome check . --write",
		"generate:openapi": "bun run --filter './apps/dokploy' generate:openapi"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.15",
		"@types/node": "^24.19.2",
		"dotenv": "18.0.8",
		"esbuild": "0.28.2",
		"lint-staged": "^15.5.2",
		"node-gyp": "13.1.0",
		"tsx": "4.23.15"
	},
	"packageManager": "bun@1.4.2",
	"engines": {
		"node": "^24.4.0",
		"bun": ">=1.4.2"
	},
	"lint-staged": {
		"*": [
			"biome check --write --no-errors-on-unmatched --files-ignore-unknown=true"
		]
	},
	"resolutions": {
		"@types/react": "18.3.5",
		"@types/react-dom": "18.3.0"
	},
	"overrides": {
		"better-auth": "1.7.7",
		"next": "16.4.0",
		"better-call": "1.4.0",
		"@better-auth/utils": "0.5.0",
		"@better-fetch/fetch": "1.3.2",
		"drizzle-orm": "0.45.4",
		"esbuild": "0.28.2",
		"h3": "1.15.11",
		"hono": "4.13.13",
		"js-yaml": "4.3.2",
		"lodash": "4.18.1",
		"postcss": "8.5.28",
		"postgres": "3.4.9",
		"ssh2": "1.16.0",
		"tar": ">=7.5.19 <8.0.0",
		"protobufjs": ">=7.5.5 <8.0.0",
		"vite": "8.3.2",
		"@codemirror/state": "6.7.6",
		"axios": ">=1.20.0 <2.0.0",
		"proxy-addr": ">=2.0.8 <3.0.0",
		"source-map-js": ">=1.2.2 <2.0.0",
		"qs": ">=6.16.0 <7.0.0",
		"@grpc/grpc-js": ">=1.14.5 <2.0.0",
		"http-cache-semantics": ">=4.3.0 <5.0.0",
		"@tailwindcss/typography>postcss-selector-parser": "7.1.6",
		"remarkable>argparse": "2.0.1"
	}
}
