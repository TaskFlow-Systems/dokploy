# syntax=docker/dockerfile:1
FROM node:26.13.0-trixie-slim@sha256:e4db4c914bf8ad241bd24804fc25d272d89bad97e68cdc8a1414862790a02c39 AS base
ENV BUN_INSTALL="/root/.bun"
ENV PATH="$BUN_INSTALL/bin:$PATH"
# Bun, Nixpacks and Railpack come from GitHub releases; the script falls back to
# the GitHub API when github.com fails to serve them.
COPY scripts/github-release-asset.sh /usr/local/bin/github-release-asset
# The Node base image can lag behind a Debian security update by days, and the
# image scan fails on any fixed finding, so the base stage takes every update.
RUN apt-get update \
    && apt-get upgrade -y --no-install-recommends \
    && apt-get install -y --no-install-recommends bash ca-certificates curl unzip \
    && rm -rf /var/lib/apt/lists/* \
    && bun_arch="$(uname -m | sed 's/x86_64/x64/')" \
    && github-release-asset oven-sh/bun bun-v1.4.4 "bun-linux-$bun_arch.zip" /tmp/bun.zip \
    && unzip -q /tmp/bun.zip -d /tmp/bun \
    && install -D -m 0755 "/tmp/bun/bun-linux-$bun_arch/bun" "$BUN_INSTALL/bin/bun" \
    && rm -rf /tmp/bun /tmp/bun.zip \
    && ln -sf "$BUN_INSTALL/bin/bun" "$BUN_INSTALL/bin/bunx" \
    && npm install -g node-gyp@13.1.0

FROM base AS build
COPY . /usr/src/app
WORKDIR /usr/src/app

RUN apt-get update && apt-get install -y python3 make g++ git python3-pip pkg-config libsecret-1-dev && rm -rf /var/lib/apt/lists/*

# Install dependencies
RUN --mount=type=cache,id=bun,target=/root/.bun/install/cache bun install --frozen-lockfile

# Deploy only the dokploy app

ENV NODE_ENV=production
RUN bun run --filter './packages/server' build
RUN bun run --filter './apps/schedules' build

RUN bun install --production --frozen-lockfile --linker hoisted

RUN mkdir -p /prod/schedules \
    && cp -R /usr/src/app/apps/schedules/package.json /prod/schedules/package.json \
    && cp -R /usr/src/app/node_modules /prod/schedules/node_modules \
    && mkdir -p /prod/schedules/packages \
    && cp -R /usr/src/app/packages/server /prod/schedules/packages/server \
    && rm -f /prod/schedules/node_modules/dokploy \
    && rm -f /prod/schedules/node_modules/@dokploy/api \
    && rm -f /prod/schedules/node_modules/@dokploy/schedules

RUN cp -R /usr/src/app/apps/schedules/dist /prod/schedules/dist

FROM base AS dokploy
WORKDIR /app

# Set production
ENV NODE_ENV=production

# Copy only the necessary files
COPY --from=build /prod/schedules/dist ./dist
COPY --from=build /prod/schedules/package.json ./package.json
COPY --from=build /prod/schedules/node_modules ./node_modules
COPY --from=build /prod/schedules/packages ./packages

ENV HOSTNAME=0.0.0.0
CMD ["bun", "run", "start"]
