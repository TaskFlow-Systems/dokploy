{
  "name": "@dokploy/server",
  "version": "1.0.0",
  "main": "./src/index.ts",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./db": {
      "import": "./src/db/index.ts",
      "require": "./dist/db/index.cjs.js"
    },
    "./setup/*": {
      "import": "./src/setup/*.ts",
      "require": "./dist/setup/index.cjs.js"
    },
    "./constants": {
      "import": "./src/constants/index.ts",
      "require": "./dist/constants.cjs.js"
    },
    "./utils/schedules/signed-job": {
      "import": "./src/utils/schedules/signed-job.ts",
      "require": "./dist/utils/schedules/signed-job.js"
    },
    "./utils/deployments/signed-job": {
      "import": "./src/utils/deployments/signed-job.ts",
      "require": "./dist/utils/deployments/signed-job.js"
    }
  },
  "scripts": {
    "build": "bun run switch:prod && rimraf dist && tsc --project tsconfig.server.json && tsc-alias -p tsconfig.server.json",
    "build:types": "tsc --emitDeclarationOnly --experimenta-dts",
    "switch:dev": "node scripts/switchToSrc.js",
    "switch:prod": "node scripts/switchToDist.js",
    "dev": "rimraf dist && bun run esbuild && tsc --emitDeclarationOnly --outDir dist -p tsconfig.server.json",
    "esbuild": "tsx ./esbuild.config.ts && tsc --project tsconfig.server.json --emitDeclarationOnly ",
    "typecheck": "tsc --noEmit",
    "dbml:generate": "npx tsx src/db/schema/dbml.ts",
    "generate:drizzle": "auth generate --config src/lib/auth-cli.ts --adapter drizzle --dialect postgresql --output auth-schema2.ts --yes"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.89",
    "@ai-sdk/azure": "^4.0.112",
    "@ai-sdk/cohere": "^4.0.71",
    "@ai-sdk/deepinfra": "^3.0.80",
    "@ai-sdk/mistral": "^4.0.74",
    "@ai-sdk/openai": "^4.0.104",
    "@ai-sdk/openai-compatible": "^3.0.80",
    "@aws-sdk/client-cloudwatch": "^3.1158.0",
    "@aws-sdk/client-cloudwatch-logs": "^3.1158.0",
    "@aws-sdk/client-route-53": "^3.1158.0",
    "@aws-sdk/client-secrets-manager": "^3.1158.0",
    "@aws-sdk/client-ssm": "3.1156.0",
    "@better-auth/api-key": "1.7.12",
    "@better-auth/passkey": "1.7.12",
    "@better-auth/scim": "1.7.12",
    "@better-auth/sso": "1.7.12",
    "@better-auth/utils": "0.5.0",
    "@faker-js/faker": "^10.6.0",
    "@octokit/auth-app": "^8.3.1",
    "@oslojs/crypto": "1.0.1",
    "@oslojs/encoding": "1.1.0",
    "@react-email/components": "^1.0.12",
    "@trpc/server": "11.19.0",
    "adm-zip": "^0.6.1",
    "ai": "^7.0.154",
    "ai-sdk-ollama": "^4.6.0",
    "bcrypt": "6.0.0",
    "better-auth": "1.7.12",
    "bl": "7.0.13",
    "boxen": "^9.0.0",
    "date-fns": "4.4.0",
    "dockerode": "5.0.1",
    "dotenv": "18.0.9",
    "drizzle-dbml-generator": "0.10.0",
    "drizzle-orm": "^0.45.4",
    "drizzle-zod": "0.8.3",
    "lodash": "^4.18.1",
    "micromatch": "4.0.8",
    "nanoid": "6.0.2",
    "node-os-utils": "3.1.0",
    "node-pty": "1.1.0",
    "node-schedule": "2.1.1",
    "nodemailer": "10.2.1",
    "octokit": "5.0.5",
    "pino": "10.4.0",
    "pino-pretty": "13.2.0",
    "postgres": "^3.4.9",
    "public-ip": "8.0.0",
    "qrcode": "^1.5.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "resend": "^6.35.0",
    "semver": "7.8.5",
    "shell-quote": "^1.12.0",
    "slugify": "^1.6.9",
    "ssh2": "~1.16.0",
    "toml": "5.0.1",
    "undici": "8.12.3",
    "ws": "8.22.0",
    "yaml": "2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bcrypt": "6.0.0",
    "@types/dockerode": "4.0.2",
    "@types/lodash": "4.17.27",
    "@types/micromatch": "4.0.10",
    "@types/node": "^26.6.5",
    "@types/node-schedule": "2.1.8",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/semver": "7.8.0",
    "@types/shell-quote": "^1.7.5",
    "@types/ssh2": "1.15.6",
    "@types/ws": "8.18.2",
    "auth": "1.7.12",
    "drizzle-kit": "^0.31.11",
    "esbuild": "^0.28.2",
    "esbuild-plugin-alias": "0.2.1",
    "rimraf": "6.1.3",
    "tsc-alias": "1.9.9",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "packageManager": "bun@1.4.4",
  "engines": {
    "node": "^26.12.1",
    "bun": ">=1.4.2"
  }
}
